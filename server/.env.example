NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000

# Leave MONGODB_URI blank to use an in-memory MongoDB instance for local dev
MONGODB_URI=

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

CREDENTIAL_ENCRYPTION_KEY=change-me-to-a-32-byte-key

# Leave blank to run executions in-process without a queue
REDIS_URL=

# AI workflow generation: OpenRouter is tried first, then Gemini, then a
# deterministic rule-based fallback if neither key is set.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Google OAuth client - shared by the Gmail and Google Sheets integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack OAuth app
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Discord OAuth app + bot (the bot token is used for posting messages,
# separate from the OAuth client used to authorize adding the bot to a server)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
