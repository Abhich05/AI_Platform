NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Leave MONGODB_URI blank to use an in-memory MongoDB instance for local dev
MONGODB_URI=

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

CREDENTIAL_ENCRYPTION_KEY=change-me-to-a-32-byte-key

REDIS_URL=

OPENROUTER_API_KEY=
GEMINI_API_KEY=
